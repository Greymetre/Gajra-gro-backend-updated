# Merge these settings into backend .env; preserve existing JWT/application settings.
DB_URL=mongodb://127.0.0.1:27017/gajragear
NODE_ENV=development
PORT=4000
NODE_PORT=4000
ENABLE_CRON_JOBS=false
# R2 dashboard > S3 API endpoint (not the public image domain)
R2_ENDPOINT=
# Bucket-scoped Object Read & Write S3 API credentials
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=gajragro2-fieldkonnect-io
R2_REGION=auto

# Gajra Gears SFA sync; SFA_SYNC_KEY must match GAJRA_GRO_SYNC_KEY on the SFA server
SFA_API_URL=https://gajragears.fieldkonnect.io/api
SFA_SYNC_KEY=
